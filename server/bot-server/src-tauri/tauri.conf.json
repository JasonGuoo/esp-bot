{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESP Bot Server",
  "version": "0.1.0",
  "identifier": "ai.reasonia.espbot.server",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "ESP Bot Server",
      "width": 1180,
      "height": 800,
      "minWidth": 760,
      "minHeight": 540,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data: blob: https:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src https:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "resources": { "../local-models/": "local-models/", "../tools/": "tools/", "../examples/": "examples/" },
    "macOS": { "minimumSystemVersion": "13.0", "entitlements": "Entitlements.plist" }
  }
}
