{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESP Bot Server",
  "version": "0.1.0",
  "identifier": "ai.reasonia.espbot.server",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小呆 · Bot Server",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "headers": {
        "Permissions-Policy": "camera=(self), microphone=(self), geolocation=()"
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' blob: https:; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1421 ws://127.0.0.1:1421; img-src 'self' data: blob: https:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' blob: https:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/xiaodai.png",
      "icons/xiaodai.icns"
    ],
    "resources": {
      "../local-models/worker.py": "local-models/worker.py",
      "../local-models/model_store.py": "local-models/model_store.py",
      "../local-models/models.json": "local-models/models.json",
      "../local-models/rma_qwen.py": "local-models/rma_qwen.py",
      "../local-models/memory_extract.py": "local-models/memory_extract.py",
      "../local-models/say_guard.py": "local-models/say_guard.py",
      "../local-models/NOTICE.md": "local-models/NOTICE.md",
      "../tools/": "tools/",
      "../examples/": "examples/",
      "../local-models/diarization.py": "local-models/diarization.py",
      "../local-models/graphiti_worker.py": "local-models/graphiti_worker.py",
      "../local-models/media_prepare.py": "local-models/media_prepare.py",
      "../local-models/requirements-diarization.txt": "local-models/requirements-diarization.txt",
      "../local-models/requirements-graphiti.txt": "local-models/requirements-graphiti.txt"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
