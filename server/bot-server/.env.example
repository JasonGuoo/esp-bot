# Export these variables in the process launching Rust/Tauri. No real keys here.
# Coding Plan keys/endpoints are distinct from ordinary pay-as-you-go API keys.
QWEN_CODING_PLAN_API_KEY=
GLM_CODING_PLAN_API_KEY=
DEEPSEEK_API_KEY=
# Optional separate Search/Fetch key. Empty uses DEEPSEEK_API_KEY.
DEEPSEEK_SEARCH_API_KEY=
# Managed mode creates an ephemeral password if this is empty.
# Attach mode requires the exact password of the separately launched OpenCode v2.
XIAODAI_OPENCODE_PASSWORD=
