#!/bin/sh
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Library/Developer/CommandLineTools}"
if [ "$#" -gt 1 ]; then echo "Use tools/sim-bot --help" >&2; exit 2; fi
case "${1:-demo}" in
    demo)
        exec cargo test --offline --locked --manifest-path "$repo/server/bot-server/src-tauri/Cargo.toml" --lib \
          brain::gateway::tests::simulator::host_bot_completes_clock_turn_and_rejects_late_reply -- --exact --nocapture ;;
    children)
        umask 077
        base="${HOME}/Library/Caches/esp-bot/children"
        mkdir -p "$base"
        XIAODAI_DIALOGUE_REPORT=$(mktemp -d "$base/run.XXXXXXXX")
        export XIAODAI_DIALOGUE_REPORT
        echo "Transcripts: $XIAODAI_DIALOGUE_REPORT"
        cargo test --offline --locked --manifest-path "$repo/server/bot-server/src-tauri/Cargo.toml" --lib \
          brain::gateway::tests::simulator::child_dialogues::live_ -- --ignored --test-threads=2
        exec python3 "$repo/tests/regression/children/review.py" "$XIAODAI_DIALOGUE_REPORT" ;;
    responsive)
        exec cargo test --offline --locked --manifest-path "$repo/server/bot-server/src-tauri/Cargo.toml" --lib \
          brain::gateway::tests::simulator:: -- --skip child_dialogues --test-threads=1 --nocapture ;;
    gateway)
        exec cargo test --offline --locked --manifest-path "$repo/server/bot-server/src-tauri/Cargo.toml" --lib \
          brain::gateway::tests:: -- --test-threads=4 ;;
    runtime) exec "$repo/firmware/components/bot_runtime/tests/run-host-macos.sh" runtime ;;
    shell) exec "$repo/firmware/components/bot_runtime/tests/run-host-macos.sh" simulator ;;
    -h|--help) cat <<'HELP'
tools/sim-bot [demo|shell|responsive|children|runtime|gateway]
  demo   Run the firmware + authenticated loopback gateway clock scenario.
  shell  Enter one event per line, or redirect a script on stdin. EOF exits.
  responsive   Replay the #36 slow supplement, stop and background chat scenarios.
  children   Run four synthetic family conversations with the real Luna model; save transcripts for review.
  runtime   Run the firmware interaction regressions on the Mac.
  gateway   Run the Rust gateway integration and protocol regressions.
  Events: state, sound, audio-ready, link, disconnect, touch, supplement, tick <1..600000 ms>,
          onset, end, thinking, reply <caption>, stop.
  Each event prints the real firmware snapshot as JSON. Shell link and reply
  are injected adapter inputs. Demo connects to an isolated local Rust server.
HELP
        ;;
    *) echo "Use tools/sim-bot --help" >&2; exit 2 ;;
esac
