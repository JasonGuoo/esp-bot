menu "Xiaodai local runtime"

    config BOT_RUNTIME_DAY_AWAKE_MS
        int "Daytime awake interval before a brief drowsy period (ms)"
        range 1000 86400000
        default 1200000
        help
            Begins after startup, an interaction, or the end of night. Daytime
            does not enter indefinite sleep merely because nobody interacts.

    config BOT_RUNTIME_DAY_DROWSY_MS
        int "Duration of a daytime drowsy period (ms)"
        range 1000 3600000
        default 60000
        help
            Automatically returns to awake afterwards without creating a
            conversation. Daytime local face detection may remain active.

    config BOT_RUNTIME_WAKING_MS
        int "Waking expression duration (milliseconds)"
        range 0 10000
        default 500

    config BOT_RUNTIME_PROGRESS_TIMEOUT_MS
        int "Maximum conversation progress gap (milliseconds)"
        range 10001 3600000
        default 60000
        help
            Hard upper bound between meaningful conversation transitions.
            Capture/network PCM and caption updates do not refresh this bound.
            Matching low-frequency hardware playback progress does, only after
            real codec writes. On expiry the local runtime stops output and
            closes the session. Input and output also have protocol size/time
            limits. This is not a silence detector. Must exceed WAKING_MS.
            The C API field is session_timeout_ms.

    config BOT_RUNTIME_WAKE_DEBOUNCE_MS
        int "Explicit wake debounce (milliseconds)"
        range 0 30000
        default 1500

endmenu
