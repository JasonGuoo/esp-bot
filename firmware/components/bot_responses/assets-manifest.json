      "pcm_wav_sha256": "1a59534e89b85b002ef7ac6cf3ee538348163ddd39ca33df8960c92915832f76",
      "adpcm_sha256": "d0e77dd9f2eff11d01f8c3d0f668669fe0156feeaa5ef6288dcaf72ed10a1884"
    },
    {
      "id": "offline_07",
      "text": "小呆收到，先眨个眼。",
      "offset": 1177600,
      "bytes": 15616,
      "pcm_samples": 30574,
      "duration_ms": 1911,
      "pcm_wav_sha256": "1f66f7e563a404aede37ccf5b57d8dfdeba7afebb5ab7d389c35f531e9996a76",
      "adpcm_sha256": "32a09cc287a8253318c66ad8b5ef17397498f04e07b6e30679997521ff18fcd6"
    },
    {
      "id": "offline_08",
      "text": "我在，先给你一个微笑。",
      "offset": 1193216,
      "bytes": 15872,
      "pcm_samples": 30901,
      "duration_ms": 1932,
      "pcm_wav_sha256": "8ea9a5f10524a6e981814903e71335fbd0dac75688253e1f6fffbd5333f11340",
      "adpcm_sha256": "d51d4c3acd76146635386fd3200eb0acb38827560146da8d24c27cb039bcbdf3"
    },
    {
      "id": "repeat_01",
      "text": "还在呢，你说。",
      "offset": 1209088,
      "bytes": 10496,
      "pcm_samples": 20293,
      "duration_ms": 1269,
      "pcm_wav_sha256": "9d91c6a4975b0e8af9b89e5195e9ecc1ad05325eecbc7e6af8fbd6583379cce4",
      "adpcm_sha256": "b4aaa7ced86fc204be2b5c082f7d3399da492e40d98f5703b6e69a109652b068"
    },
    {
      "id": "repeat_02",
      "text": "听见啦，不用着急。",
      "offset": 1219584,
      "bytes": 13568,
      "pcm_samples": 26388,
      "duration_ms": 1650,
      "pcm_wav_sha256": "bdfa70e43ef10070f9a903446de3c3a1af5b6fe165cb242ba6b02a8822ce8e61",
      "adpcm_sha256": "83d2dec880450b5001d109b9e595314995ae378dba3c875ce1484230ab25b525"
    },
    {
      "id": "repeat_03",
      "text": "小呆在，没走开。",
      "offset": 1233152,
      "bytes": 12544,
      "pcm_samples": 24554,
      "duration_ms": 1535,
      "pcm_wav_sha256": "36808f106ea831f312159de05019a18917654ef275b246b5d8a839b92f0071af",
      "adpcm_sha256": "3157782edbcf27ee1fb38672937da06eea16f9bae4f2c04d950e99983bab3db6"
    },
    {
      "id": "repeat_04",
      "text": "嗯，又听见你啦。",
      "offset": 1245696,
      "bytes": 10752,
      "pcm_samples": 20778,
      "duration_ms": 1299,
      "pcm_wav_sha256": "e620ff52bf91cd6fe9fd37ad31198f68ac4efe746eaea4241da427fe71203926",
      "adpcm_sha256": "58790b761428f47766b0ed40f5e19b92981e8f2390f5ec26c5e629ddafb137ad"
    },
    {
      "id": "repeat_05",
      "text": "我在，又收到你的呼唤啦。",
      "offset": 1256448,
      "bytes": 17152,
      "pcm_samples": 33375,
      "duration_ms": 2086,
      "pcm_wav_sha256": "d521c89a621c291fff433569294797dd580d10113047ff108f5cf0b37f300df0",
      "adpcm_sha256": "826d4c478fc7f60f1bdf2e8ffb451ba060b49152712c216ddf0d3a2db1430c53"
    },
    {
      "id": "repeat_06",
      "text": "在呢，接着说。",
      "offset": 1273600,
      "bytes": 10752,
      "pcm_samples": 20945,
      "duration_ms": 1310,
      "pcm_wav_sha256": "884e0031a3b2ef9354906e8d1d42251ad6e8808c174dd8169e63f177ad5ef907",
      "adpcm_sha256": "d7d3aa17c27feb6dfcbd619aed56a1cc5c37a78925ce5e8cdc791146955dbc42"
    },
    {
      "id": "repeat_07",
      "text": "收到啦，我一直在这儿。",
      "offset": 1284352,
      "bytes": 14848,
      "pcm_samples": 28818,
      "duration_ms": 1802,
      "pcm_wav_sha256": "ab1fbe8ed0edfcdfac5908e9c28feb1740bd5bad75098719c9d3362e5de13526",
      "adpcm_sha256": "6d368eb305c2c54d3bbd3ae7644edfec72bb087be7ad36afa9843f49023138c7"
    },
    {
      "id": "repeat_08",
      "text": "小呆在，认真听。",
      "offset": 1299200,
      "bytes": 13056,
      "pcm_samples": 25338,
      "duration_ms": 1584,
      "pcm_wav_sha256": "6332ba941c62e602035501d8817d89c5c81b8cce72926d7bf86ddbfaa4d18b7e",
      "adpcm_sha256": "e8a1a410f256771321af3a67327256500bcbfc54dac748e95c4a63d783dff8a3"
    },
    {
      "id": "no_face_01",
      "text": "我在，还没找到你的脸。",
      "offset": 1312256,
      "bytes": 14848,
      "pcm_samples": 28986,
      "duration_ms": 1812,
      "pcm_wav_sha256": "7669852404b5b0de9c4b493b3904e7b55eaedffa1186f6bbfa0b31c65c44feb9",
      "adpcm_sha256": "4624df24cf1334dd9d3a643f67dd5cb9b3113fdb110be4b0265dccb6bb0fcb21"
    },
    {
      "id": "no_face_02",
      "text": "听见啦，我这会儿没看见你。",
      "offset": 1327104,
      "bytes": 18176,
      "pcm_samples": 35373,
      "duration_ms": 2211,
      "pcm_wav_sha256": "cd98a5bc4849bc439bc12669e2e9a6a89169036e1d4c0d66d183e69da0b1b274",
      "adpcm_sha256": "4017cbecfbd3bd72ca4f8b5d67a149f85f07a8a3dfcfda67607daabdcbc1bc22"
    },
    {
      "id": "no_face_03",
      "text": "小呆在，镜头里还没找到你。",
      "offset": 1345280,
      "bytes": 20224,
      "pcm_samples": 39614,
      "duration_ms": 2476,
      "pcm_wav_sha256": "97b0f255e9bcbb0d052a8c87056067273f69f339390158625d1f8865af80dc08",
      "adpcm_sha256": "ed8c6f4accf0bb374e4d83d2b4b0d13f6e1e0d0372af660ba215e6785ad7c6e9"
    },
    {
      "id": "no_face_04",
      "text": "我在，暂时没看清你。",
      "offset": 1365504,
      "bytes": 14848,
      "pcm_samples": 29275,
      "duration_ms": 1830,
      "pcm_wav_sha256": "aa4819bbe283eb96b541e960c3e3d1794cb5fc465f71910ebba05e79f8aae1f6",
      "adpcm_sha256": "993db65cbeaa95c32a4bcaab0c101ee4b16861de71e2e752afa64aeb225e6558"
    },
    {
      "id": "no_face_05",
      "text": "听见你的呼唤啦，先说吧。",
      "offset": 1380352,
      "bytes": 20736,
      "pcm_samples": 40548,
      "duration_ms": 2535,
      "pcm_wav_sha256": "fb2f867297261200d56928ccc8c898dcf180519b9d56b599953b65d897fb677b",
      "adpcm_sha256": "ed9a9af59f1ea4f27218cd260c894ed4fb5aa09ac5ee2dfbd54ca342dc174528"
    },
    {
      "id": "no_face_06",
      "text": "我在，不用等我看清。",
      "offset": 1401088,
      "bytes": 14336,
      "pcm_samples": 28271,
      "duration_ms": 1767,
      "pcm_wav_sha256": "cbba70d4ac38ad126f41f94c563af07c78ab4887b7edbc1afbfbfe63b1738542",
      "adpcm_sha256": "efcca71cc2184706410f6b2796b3b46239e4d8ab614499982b117091cd13a0ff"
    },
    {
      "id": "no_face_07",
      "text": "小呆在，声音已经收到啦。",
      "offset": 1415424,
      "bytes": 18944,
      "pcm_samples": 37070,
      "duration_ms": 2317,
      "pcm_wav_sha256": "4a283ee57de49ad733325d5ba5318c0cb931bee896b12c206d8f3b381dee9d9f",
      "adpcm_sha256": "f39a2038858c46167ae2891af202d474dfe12d1b63258e6c426a8786076644b6"
    },
    {
      "id": "no_face_08",
      "text": "我在，先听你说。",
      "offset": 1434368,
      "bytes": 12032,
      "pcm_samples": 23712,
      "duration_ms": 1482,
      "pcm_wav_sha256": "7e440dbe07b4b769d1edb21c0f99c59eca0064438b3cc0efda7b3b635a394567",
      "adpcm_sha256": "79d918337679040a2c7e9bcd515b7fc89d8ff25aa7cf63fda4f763e374f01d11"
    }
