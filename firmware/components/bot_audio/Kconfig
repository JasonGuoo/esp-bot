menu "Xiaodai local audio"

config BOT_AUDIO_WAKE_MODEL_NAME
    string "Exact custom WakeNet model entry name"
    default ""
    help
        Provision an Espressif-compatible ESP32-S31 WakeNet model for the entire
        phrase 小呆小呆. Runtime requires both an exact entry-name match and exact
        full wake-word metadata. A valid dedicated model takes priority over
        the complete-phrase MultiNet7 fallback below. No stock keyword,
        split-name counter or VAD wake is substituted.

config BOT_AUDIO_MULTINET_WAKE_FALLBACK
    bool "Recognize complete xiao dai xiao dai locally with MultiNet7"
    depends on IDF_TARGET_ESP32S31
    default y
    help
        Uses ESP-SR's Chinese mn7_cn engine continuously when a matching
        dedicated WakeNet is unavailable. Passive mode installs exactly one
        whole phrase; an explicit session can additionally enable fixed local
        controls. No custom training or cloud service is needed.
        Also select SR_MN_CN_MULTINET7_QUANT and SR_MN_EN_NONE in ESP Speech
        Recognition so the pinned component packages the actual model. The
        build rejects a missing model selection instead of shipping a placeholder.
        CPU/RAM cost and acoustic accuracy need validation on this S31 board.

config BOT_AUDIO_MULTINET_THRESHOLD_PERCENT
    int "MultiNet full-command score threshold (percent, uncalibrated)"
    depends on BOT_AUDIO_MULTINET_WAKE_FALLBACK
    range 40 99
    default 80
    help
        Applied both to the model and to the highest-scoring result. This is a
        model score, not a measured confidence or a false-accept probability.
        Higher values can reduce false wakes but also miss genuine calls.

config BOT_AUDIO_MULTINET_WINDOW_MS
    int "MultiNet detection window (ms)"
    depends on BOT_AUDIO_MULTINET_WAKE_FALLBACK
    range 1000 6000
    default 3000
    help
        Native recognizer timeout. Detection, timeout, playback suppression,
        permission fences and 600 ms of low-energy silence clear partial state.

config BOT_AUDIO_LOCAL_COMMAND_THRESHOLD_PERCENT
    int "Active-session local command score threshold (percent)"
    depends on BOT_AUDIO_MULTINET_WAKE_FALLBACK
    range 70 99
    default 85
    help
        Fixed offline controls are available only after explicit activation.
        This is an uncalibrated model score; never a measured accuracy claim.

config BOT_AUDIO_START_BUFFER_MS
    int "Maximum explicitly authorized same-token start buffer (ms)"
    range 300 1500
    default 800
    help
        Bounded PSRAM only, after a runtime capture lease and RX/AFE fence.
        Keeps the latest samples while this token waits for transport readiness.
        Never stores passive/pre-wake audio; stop, playback, command consumption,
        revocation and token changes clear it. No cross-turn relabelling.

config BOT_AUDIO_AFE_RECOVERY_LIMIT
    int "Automatic AFE reset retries per start"
    range 0 3
    default 2
    help
        Reuses the existing AFE, with a delay, without restarting I2S or freeing
        live buffers. A persistent failure keeps explicit/manual operation.

config BOT_AUDIO_MODEL_PARTITION
    string "Model data partition label"
    default "model"
    help
        Must match a data partition in the project's partition table. Use the
        official ESP-SR MODEL_IN_FLASH path and external model packer.

config BOT_AUDIO_OUTPUT_VOLUME
    int "Default codec output volume (percent)"
    range 0 60
    default 30
    help
        Conservative electrical gain cap. This is not a measured acoustic
        exposure limit; speaker enclosure and listening distance need hardware
        validation before child use.

config BOT_AUDIO_MIC_GAIN_DB
    int "Microphone codec gain (dB)"
    range 0 42
    default 36

config BOT_AUDIO_WAKE_DEBOUNCE_MS
    int "Minimum gap between accepted full-phrase wake events (ms)"
    range 500 10000
    default 2000

config BOT_AUDIO_PLAYBACK_TAIL_MS
    int "Self-wake suppression tail after playback (ms)"
    range 200 3000
    default 800
    help
        Until reference synchronization is measured, wake events and VAD are
        suppressed from playback BEGIN, while the speaker plays and during
        this tail. PCM uplink is also withheld. Intentional
        touch/local stop can always cancel playback. Not a substitute for AEC.

config BOT_AUDIO_PLAYBACK_QUEUE_FRAMES
    int "Bounded playback queue capacity (20 ms frames)"
    range 4 32
    default 12

config BOT_AUDIO_WORKER_PRIORITY
    int "Audio worker priority"
    range 4 15
    default 8

endmenu
