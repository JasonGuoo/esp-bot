menu "ESP Bot"
    config ESPBOT_WIFI_SSID
        string "Wi-Fi SSID (leave blank for face-only demo)"
        default ""

    config ESPBOT_WIFI_PASSWORD
        string "Wi-Fi password (stored locally in sdkconfig)"
        default ""

    config ESPBOT_BRAIN_URL
        string "Brain HTTP base URL (e.g. http://192.168.1.5:8766)"
        default ""

    config ESPBOT_AUTH_TOKEN
        string "Brain shared bearer token (LAN development only)"
        default ""

    config ESPBOT_DEVICE_ID
        string "Device ID (ASCII URL-safe)"
        default "korvo-01"
endmenu
