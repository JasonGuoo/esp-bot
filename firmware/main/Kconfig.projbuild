menu "ESP Bot"
    config ESPBOT_USB_DEBUG_PREVIEW
        bool "Enable supervised USB screen/camera preview"
        default n
        depends on ESPBOT_USB_MANUAL_CONTROL
        select LV_USE_SNAPSHOT
        help
            Explicit preview on/off and a 15-second keepalive lease enable
            two bounded JPEG previews and pixel-free runtime events over USB.
            Camera requires an explicit local wake or supervised USB camera
            command; night dark, settings and critical faults suppress it.

    config ESPBOT_USB_MANUAL_CONTROL
        bool "Enable local USB console wake/stop for board bring-up"
        default n
        help
            Accept exact wake and stop lines on the physical console UART.
            Wake posts the same intentional local event as a screen touch.
            No remote commands, media access or automatic wake is enabled.
            Disabled by default; intended for supervised board diagnosis.

    config ESPBOT_WIFI_SSID
        string "Wi-Fi SSID (blank reuses saved Wi-Fi, otherwise stays offline)"
        default ""

    config ESPBOT_WIFI_PASSWORD
        string "Wi-Fi password (stored locally in sdkconfig)"
        default ""

    config ESPBOT_DEVICE_ID
        string "Device ID (ASCII URL-safe)"
        default "korvo-01"

    config ESPBOT_SERVER_ID
        string "Preferred diagnostic bot-server ID (blank selects a sole server)"
        default ""
        help
            Discover the configured server again after each boot or connection
            loss, including when its DHCP address or listening port changes.
            Other servers are not selected automatically when this is set.
            This public ID selects a diagnostic endpoint; it is not authentication.

    config ESPBOT_NIGHT_SCHEDULE
        bool "Apply local night schedule when wall clock is valid"
        default y
        help
            After Wi-Fi connects, ESP-IDF SNTP synchronizes a local wall clock.
            When no valid clock is available the device does not guess night.
            SNTP is for the sleep schedule, not authentication or session time.

    config ESPBOT_NTP_SERVER
        string "SNTP server used by the night schedule"
        default "pool.ntp.org"
        depends on ESPBOT_NIGHT_SCHEDULE

    config ESPBOT_TIMEZONE
        string "POSIX timezone for night schedule"
        default "CST-8"
        depends on ESPBOT_NIGHT_SCHEDULE

    config ESPBOT_NIGHT_START_MINUTE
        int "Night begins, minutes after local midnight"
        range 0 1439
        default 1350
        depends on ESPBOT_NIGHT_SCHEDULE

    config ESPBOT_NIGHT_END_MINUTE
        int "Night ends, minutes after local midnight"
        range 0 1439
        default 420
        depends on ESPBOT_NIGHT_SCHEDULE

    config ESPBOT_GAZE_CALIBRATED
        bool "Camera-to-display orientation/geometry physically calibrated"
        default n
        help
            Keep disabled until real hardware calibration. Approximate visual
            following remains allowed, but mutual gaze is never claimed without
            calibration AND an independent human-gaze estimator.

    config ESPBOT_CAMERA_ROTATE_180
        bool "Rotate camera input 180 degrees"
        default n
        help
            The SC101IOT unit observed during board bring-up produced an
            upside-down preview with the old 180-degree rotation enabled.
            Leave disabled for that mounting. Other camera modules or mountings
            must be checked in the live preview; this is not an IMU measurement.

    config ESPBOT_GAZE_MIRROR_X
        bool "Mirror camera eye midpoint for display gaze"
        default n

    config ESPBOT_GAZE_MIRROR_Y
        bool "Mirror vertical eye midpoint for display gaze"
        default n

    config ESPBOT_CAMERA_FOV_X_DEG
        int "Approximate horizontal camera field of view, degrees"
        range 10 160
        default 60
        help
            Initial mapping parameter, not a measured OV3660 lens specification.
            Replace with calibrated effective FOV for the installed camera.

    config ESPBOT_CAMERA_FOV_Y_DEG
        int "Approximate vertical camera field of view, degrees"
        range 10 140
        default 45
endmenu
