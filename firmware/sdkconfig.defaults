# ESP32-S31 Korvo-1 V1.1; adapted from the official BSP camera/display example.
# Manually maintained defaults; first-board results are in docs/board-bringup-2026-11-06.md.
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# Keep hardware reset protection active when the supply voltage falls.
CONFIG_ESP_BROWNOUT_DET=y
# Detect/retry incomplete NVS sector erases under unstable supply conditions.
CONFIG_NVS_FLASH_VERIFY_ERASE=y
CONFIG_NVS_FLASH_ERASE_ATTEMPTS=2
# Daytime stays lively; 22:30-07:00 local time is the initial night window.
CONFIG_ESPBOT_NIGHT_SCHEDULE=y
CONFIG_ESPBOT_TIMEZONE="CST-8"
CONFIG_ESPBOT_NIGHT_START_MINUTE=1350
CONFIG_ESPBOT_NIGHT_END_MINUTE=420
# The app handles peripheral errors and keeps other local modules available.
CONFIG_BSP_ERROR_CHECK=n
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CODEC_ES8389_SUPPORT=y

# Official S31 RGB/LVGL settings. No S3-only pin/cache options are copied.
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=2
CONFIG_BSP_LCD_RGB_REFRESH_AUTO=y
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE=n
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
# The full-size static Chinese font needs offsets larger than 1 MiB.
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# Official OV3660 DVP sensor configuration; model/image conversion is in bot_vision.
CONFIG_CAMERA_XCLK_USE_LEDC=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_640X480_10FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_640X480_10FPS=y
# The delivered board was identified from its factory firmware as SC101IOT.
# Retain OV3660 detection for older kits; both use the official sensor drivers.
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_640X480_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_15FPS=n
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_640X480_15FPS=y
CONFIG_CAM_CTRL_SPI_ENABLE=n
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y

# WakeNet name intentionally empty until the complete 小呆小呆 model is supplied.
CONFIG_BOT_AUDIO_WAKE_MODEL_NAME=""
CONFIG_BOT_AUDIO_MODEL_PARTITION="model"
CONFIG_BOT_AUDIO_MIC_GAIN_DB=36
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_VADN_WEBRTC=y
